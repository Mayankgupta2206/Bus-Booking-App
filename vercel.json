{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/ticket",
      "destination": "/ticket.html"
    },
    {
      "source": "/pass",
      "destination": "/ticket.html"
    }
  ],
  "crons": [
    {
      "path": "/api/archive/run",
      "schedule": "30 20 * * *"
    }
  ]
}
